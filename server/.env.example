# Port the Express server listens on.
PORT=3001

# Path to the SQLite database file. In the container this lives on the
# /app/data volume so it survives restarts.
DB_PATH=/app/data/kitchen-ledger.db

# Directory where uploaded item photos are stored. In the container this
# lives on the /app/data volume so it survives restarts.
UPLOADS_DIR=/app/data/uploads
