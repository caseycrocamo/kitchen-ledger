# Copy this to .env (same directory as docker-compose.yml / docker-compose.prod.yml)
# and fill in a real password. docker compose loads .env automatically.

# Host port the web UI is published on (http://<host>:$WEB_PORT).
WEB_PORT=8080

# Port the api container listens on internally, and the port nginx (in the web
# container) proxies /api/ requests to. Only needs to change if it conflicts
# with something else on the internal compose network — not published to the host.
API_PORT=3001

# Postgres credentials — used both to initialize the db container and by the
# api container to connect to it.
POSTGRES_USER=kitchen
POSTGRES_PASSWORD=change-me
POSTGRES_DB=kitchen_ledger
